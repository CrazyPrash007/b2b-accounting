# .env.example
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/accounting_dev
CHAT_STARTER_MONGO_URI=mongodb://127.0.0.1:27017/chat-starter

# Frontend URLs for CORS configuration (comma-separated)
# Local development
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4000,http://localhost:5173

# Production example (uncomment and modify for production):
# ALLOWED_ORIGINS=https://accounting.b2bbilling.com,https://b2bbilling.com,https://www.b2bbilling.com

# Authentication is handled via Authorization header with proto-token format
# The token format is: "proto-token:<userId>" where userId is a MongoDB ObjectId

# DEV_OWNER_ID is optional and only used for development when no auth token is provided
# DEV_OWNER_ID=692ae3a94ccb2c43c3d2469a
